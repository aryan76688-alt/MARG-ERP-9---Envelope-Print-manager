# ==============================================================================
# MARG ERP 9 Envelope Manager — Environment Variables Template
# Copy to backend/.env ONLY if you want to override local defaults.
# For normal local development, NO .env file is required (uses safe SQLite DB).
# ==============================================================================

# Leave blank locally to use automatic SQLite DB (backend/data/envelope_manager.db).
# Production Termux uses PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/envelope_db

# JWT signing secret (auto-defaults for local dev; override in production)
# JWT_SECRET_KEY=change-me-in-production

# Optional AI features (Gemini / OpenAI)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key

# Optional Google Maps API key for geocoding/directions enhancements
# GOOGLE_MAPS_API_KEY=your-google-maps-key

# Optional Order Book cross-sync settings
# ORDER_BOOK_API_URL=http://127.0.0.1:3000
# ORDER_BOOK_REMOTE_URL=https://shreeji-order.aryan76688.workers.dev
# MARG_SYNC_SECRET=change-me
